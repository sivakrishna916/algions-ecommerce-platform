# Copy to .env and fill in. NEVER commit .env
NODE_ENV=development
PORT=5000
# Local MongoDB or a MongoDB Atlas free-tier connection string
MONGO_URI=mongodb://127.0.0.1:27017/algions_ecommerce
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Pricing configuration (amounts in paise; tax in percent)
TAX_RATE_PERCENT=18
SHIPPING_FLAT_PAISE=4900
FREE_SHIPPING_THRESHOLD_PAISE=99900
LOW_STOCK_THRESHOLD=5

# Dummy credentials used ONLY by `npm run seed` (demo data)
SEED_ADMIN_EMAIL=admin@demo.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@demo.test
SEED_CUSTOMER_PASSWORD=Customer@2415
